# Step 2 host authentication and profile storage. See docs/SUPABASE_SETUP.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Step 6: separate Calendar OAuth client, server-only values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with cryptography.fernet.Fernet.generate_key(); retain across restarts.
TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=http://127.0.0.1:8017
# Hosted private staging only: HTTPS origin, strong password and encryption key required.
STAGING_PRIVATE=false
STAGING_ACCESS_PASSWORD=
# Step 7 server-only email configuration. Test sender emails only your Resend account.
RESEND_API_KEY=
EMAIL_FROM=PetCalendar AI <onboarding@resend.dev>
# Step 9: server-only scheduling assistant, never a VITE_ variable.
# Enable only after the dedicated project spending cutoff is verified.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
